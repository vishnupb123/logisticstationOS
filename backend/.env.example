# Copy to backend/.env for local (non-Docker) development. No real secrets —
# these mirror app/core/config.py's defaults so docker-compose and a manual
# venv run use the same credentials.

APP_NAME=StationOS
ENV=development
DEBUG=true
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=stationos
POSTGRES_PASSWORD=stationos
POSTGRES_DB=stationos

DUCKDB_PATH=../data/analytics/stationos.duckdb

# LLMProvider (ADR-0008) — OllamaProvider's target. No API key: Ollama is a
# local server you run yourself (not installed by this project). Only
# matters if you construct OllamaProvider; FakeLLMProvider needs neither.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
